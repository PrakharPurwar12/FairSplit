# ==========================================
# FairSplit Backend - Render Production .env
# ==========================================

# ------------------------------------------
# Django Core Settings
# ------------------------------------------
# Required: Secret key for Django cryptographic signing and session security
SECRET_KEY=your-render-production-secret-key-here

# Required for Production: Set to False to disable debug mode in production
DEBUG=False

# Required: Comma-separated list of allowed hostnames (include your Render hostname or *)
ALLOWED_HOSTS=fairsplit-backend-e67j.onrender.com,localhost,127.0.0.1
 
# ------------------------------------------
# Database Configuration (Neon PostgreSQL)
# ------------------------------------------
# Required: Connection string for Neon PostgreSQL database
# Format: postgresql://<user>:<password>@<neon-hostname>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/fairsplit?sslmode=require

# ------------------------------------------
# CORS & CSRF Configuration
# ------------------------------------------
# Required: Set to False in production for strict CORS security
CORS_ALLOW_ALL_ORIGINS=False

# Required: Comma-separated list of allowed frontend origins (your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://fairsplit-5w3v.vercel.app,https://fair-split-5w3v.vercel.app

# Required: Comma-separated list of trusted origins for CSRF validation
CSRF_TRUSTED_ORIGINS=https://fairsplit-backend-e67j.onrender.com,https://fairsplit-5w3v.vercel.app,https://fair-split-5w3v.vercel.app

# ------------------------------------------
# Frontend & Application URLs
# ------------------------------------------
# Required: Public URL of your deployed frontend (used in email links)
FRONTEND_URL=https://fairsplit-5w3v.vercel.app

# ------------------------------------------
# OAuth Credentials (Google & GitHub)
# ------------------------------------------
# Optional/Required for Google Login: Google OAuth Client ID & Secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://fair-split-5w3v.vercel.app/auth/callback

# Optional/Required for GitHub Login: GitHub OAuth Client ID & Secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ------------------------------------------
# Email Configuration (SMTP / Gmail)
# ------------------------------------------
# Required for Email Delivery: Django Email Backend (default: SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=FairSplit Team <your-email@gmail.com>

# ------------------------------------------
# Security Hardening Flags (Production HTTPS)
# ------------------------------------------
# Optional overrides for production security settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
X_FRAME_OPTIONS=DENY
SECURE_CONTENT_TYPE_NOSNIFF=True
