# FairSplit Backend Production Environment Template

# Django Core Settings
SECRET_KEY=generate-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.onrender.com,.ondigitalocean.app
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://fairsplit-5w3v.vercel.app,https://fairsplit.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://fairsplit-5w3v.vercel.app,https://fairsplit.vercel.app,https://*.railway.app,https://*.onrender.com,https://*.ondigitalocean.app

# Production Security Hardening (Set to True in HTTPS Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
X_FRAME_OPTIONS=DENY
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin

# Platform Host Discovery (Automatically parsed if deployed on Railway / Render / DigitalOcean)
RENDER_EXTERNAL_HOSTNAME=fairsplit-backend.onrender.com
RAILWAY_PUBLIC_DOMAIN=fairsplit-backend.up.railway.app
PUBLIC_URL=https://api.fairsplit.com
PORT=8000
LOG_LEVEL=INFO

# Database Configuration (Neon PostgreSQL, AWS RDS, DigitalOcean Managed DB)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/fairsplit?sslmode=require
DB_ENGINE=django.db.backends.postgresql
DATABASE_NAME=fairsplit
DATABASE_USER=fairsplit_user
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://fairsplit.vercel.app/auth/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Configuration (SMTP or Brevo Transactional Email)
EMAIL_BACKEND=backend.email_backend.IPv4EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=FairSplit Team <noreply@fairsplit.com>

# Brevo HTTP API (Alternative Transactional Email Provider)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@fairsplit.com
BREVO_SENDER_NAME=FairSplit Team

# Frontend & Application URLs
FRONTEND_URL=https://fairsplit.vercel.app
