# FairSplit Environment Configuration Template

# Django Core Settings
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/auth/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Database Configuration
DATABASE_NAME=fairsplit
DATABASE_USER=fairsplit_user
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Docker PostgreSQL Aliases
POSTGRES_DB=fairsplit
POSTGRES_USER=fairsplit_user
POSTGRES_PASSWORD=your-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=FairSplit Team <noreply@fairsplit.com>

# Frontend & Application URLs
FRONTEND_URL=http://localhost
INVITATION_EXPIRY_DAYS=7
