# ==============================================================================
# FairSplit-Ops Terraform Configuration Variables
# Copy this file to terraform.tfvars and customize for your environment.
# ==============================================================================

# AWS Region
aws_region = "ap-south-1"

# Environment & Project Naming
project_name = "fairsplit"
environment  = "dev"

# Security: Administrator IP CIDR for SSH (port 22) and Nagios Web UI (port 80)
# IMPORTANT: Replace with your actual public IP /32 (e.g., "203.0.113.25/32") for strict administrative access
admin_ip_cidr = "203.0.113.25/32"

# Existing EC2 Key Pair name (e.g., terra-server-key)
key_name     = "terra-server-key"
ssh_key_path = "~/.ssh/terra-server-key.pem"

# Instance Types (t3.small provides 2 GB RAM required for Puppet Server JVM and Docker Compose)
ops_instance_type = "t3.small"
app_instance_type = "t3.small"

# Storage Sizes in GB (gp3 volume type)
ops_volume_size = 15
app_volume_size = 15

# Networking: Leave blank to automatically discover and reuse the existing Default VPC and Subnet
# vpc_id    = "vpc-012757c89854197cd"
# subnet_id = "subnet-0640282fbac6e7907"

