<%- | String $allowed_hosts, String $plugin_dir | -%>
##############################################################################
# nrpe.cfg – NRPE daemon configuration
# Managed by Puppet – do NOT edit manually.
##############################################################################

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Comma-separated list of IPs/hostnames allowed to query NRPE
# No wildcard – explicit allowlist only.
allowed_hosts=<%= $allowed_hosts %>

server_port=5666
nrpe_user=nagios
nrpe_group=nagios

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
dont_blame_nrpe=0
allow_bash_command_substitution=0
debug=0
command_timeout=60
connection_timeout=300

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
log_facility=daemon
pid_file=/var/run/nagios/nrpe.pid

# ---------------------------------------------------------------------------
# Check commands
# ---------------------------------------------------------------------------
# Disk space: warn at 20% free, crit at 10% free
command[check_disk]=/usr/lib/nagios/plugins/check_disk -w 20% -c 10% -p /

# Memory: warn at 80% used, crit at 95% used
command[check_mem]=<%= $plugin_dir %>/check_mem 80 95

# Docker container status (default: fairsplit)
command[check_docker_container]=<%= $plugin_dir %>/check_docker_container fairsplit

# FairSplit HTTP health endpoint
command[check_fairsplit]=<%= $plugin_dir %>/check_fairsplit http://localhost:5000/health

# System load: warn 5/4/3, crit 10/8/6
command[check_load]=/usr/lib/nagios/plugins/check_load -w 5,4,3 -c 10,8,6

# Swap usage: warn at 60%, crit at 80%
command[check_swap]=/usr/lib/nagios/plugins/check_swap -w 40% -c 20%

# SSH service (self-check)
command[check_ssh]=/usr/lib/nagios/plugins/check_ssh -H 127.0.0.1

# Zombie processes
command[check_zombie_procs]=/usr/lib/nagios/plugins/check_procs -w 5 -c 10 -s Z
